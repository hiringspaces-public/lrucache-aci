FROM codercom/code-server:4.89.1

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates \
    libicu-dev \
    && rm -rf /var/lib/apt/lists/*

# .NET 8
RUN wget -qO /tmp/dotnet-install.sh https://dot.net/v1/dotnet-install.sh && \
    chmod +x /tmp/dotnet-install.sh && \
    /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet && \
    ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet && \
    rm /tmp/dotnet-install.sh

ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="$DOTNET_ROOT:$PATH"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

ARG REPO_URL=https://github.com/hiringspaces-public/lrucache-aci.git
ARG REPO_BRANCH=main

RUN git clone --depth=1 --branch ${REPO_BRANCH} ${REPO_URL} /home/coder/workspace && \
    chown -R coder:coder /home/coder/workspace

# Restore runs as root here, so it creates root-owned obj/ dirs. Re-chown
# afterwards so the coder user can re-restore/build at runtime without EACCES.
RUN cd /home/coder/workspace && \
    dotnet restore ./DotNet/LruCache.sln && \
    chown -R coder:coder /home/coder/workspace

COPY --chown=coder:coder extensions/hiringspaces-0.0.1.vsix /tmp/hiringspaces.vsix

USER coder
RUN code-server \
    --install-extension ms-dotnettools.csharp \
    --install-extension hediet.vscode-drawio \
    --install-extension /tmp/hiringspaces.vsix \
    || true

RUN rm /tmp/hiringspaces.vsix

RUN mkdir -p /home/coder/.config/code-server
COPY --chown=coder:coder config.yaml /home/coder/.config/code-server/config.yaml
COPY --chown=coder:coder workspace.dotnet.code-workspace /home/coder/workspace/lrucache.code-workspace
COPY --chown=coder:coder scripts/start.sh /usr/local/bin/start.sh

USER root
RUN chmod +x /usr/local/bin/start.sh
USER coder

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/start.sh"]